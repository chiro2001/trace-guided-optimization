+// Private experimental pass for exact counts from a verified complete ROI.
+#ifndef BOLT_PASSES_TRACE_PC_COUNTS_H
+#define BOLT_PASSES_TRACE_PC_COUNTS_H
+#include "bolt/Passes/BinaryPasses.h"
+#include "llvm/ADT/DenseMap.h"
+#include <fstream>
+#include <map>
+#include <sstream>
+namespace opts {
+extern llvm::cl::OptionCategory BoltOptCategory;
+inline llvm::cl::opt<std::string> TracePCCountsFile(
+    "pgo128-exact-counts", llvm::cl::desc("Verified original-VA PC and edge counts"),
+    llvm::cl::init(""), llvm::cl::Hidden, llvm::cl::cat(BoltOptCategory));
+}
+namespace llvm { namespace bolt {
+class TracePCCounts : public BinaryFunctionPass {
+public:
+  TracePCCounts() : BinaryFunctionPass(false) {}
+  const char *getName() const override { return "verified trace PC counts"; }
+  Error runOnFunctions(BinaryContext &BC) override {
+    if (opts::TracePCCountsFile.empty()) return Error::success();
+    if (!BC.isAArch64()) return createFatalBOLTError("exact PC counts require AArch64");
+    std::ifstream In(opts::TracePCCountsFile.getValue());
+    if (!In) return createFatalBOLTError("cannot open exact PC counts");
+    DenseMap<uint64_t, uint64_t> PCs;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> Edges;
+    std::string Line;
+    while (std::getline(In, Line)) {
+      std::istringstream S(Line); std::string Kind, A, B, Extra;
+      uint64_t From=0, To=0, Count=0;
+      if (!(S >> Kind >> A) || StringRef(A).getAsInteger(16, From))
+        return createFatalBOLTError("malformed exact PC count record");
+      if (Kind == "P") {
+        if (!(S >> Count) || (S >> Extra) || !Count || (From & 3) || PCs.count(From))
+          return createFatalBOLTError("invalid or duplicate PC count");
+        PCs[From] = Count;
+      } else if (Kind == "E") {
+        if (!(S >> B >> Count) || StringRef(B).getAsInteger(16, To) ||
+            (S >> Extra) || !Count || ((From | To) & 3) || Edges.count({From, To}))
+          return createFatalBOLTError("invalid or duplicate edge count");
+        Edges[{From, To}] = Count;
+      } else return createFatalBOLTError("unknown exact PC count record");
+    }
+    uint64_t Blocks=0, Observed=0, Rescued=0, EdgeRecords=0, Functions=0;
+    for (auto &Entry : BC.getBinaryFunctions()) {
+      BinaryFunction &BF=Entry.second;
+      if (!BF.isSimple() || BF.empty()) continue;
+      bool FunctionObserved=false;
+      for (BinaryBasicBlock &BB : BF) {
+        const uint64_t Start=BF.getAddress()+BB.getInputOffset();
+        const uint64_t Count=PCs.lookup(Start);
+        if (Count) {
+          ++Observed; FunctionObserved=true;
+          if (BB.getExecutionCount()==0) ++Rescued;
+        }
+        BB.setExecutionCount(Count); ++Blocks;
+        if (BB.getOriginalSize()<4) continue;
+        const uint64_t Last=BF.getAddress()+BB.getEndOffset()-4;
+        auto BI=BB.branch_info_begin();
+        for (BinaryBasicBlock *Succ : BB.successors()) {
+          const uint64_t Target=BF.getAddress()+Succ->getInputOffset();
+          auto E=Edges.find({Last,Target});
+          BI->Count=(E==Edges.end()) ? 0 : E->second;
+          if (E!=Edges.end()) ++EdgeRecords;
+          ++BI;
+        }
+      }
+      BF.setExecutionCount(PCs.lookup(BF.getAddress()));
+      BF.markProfiled(BinaryFunction::PF_BRANCH);
+      if (FunctionObserved) ++Functions;
+    }
+    BC.outs() << "PGO128-EXACT: " << PCs.size() << " PC records; "
+              << Edges.size() << " adjacent/call-return records; " << Functions
+              << " observed functions; " << Observed << "/" << Blocks
+              << " observed blocks; " << Rescued << " observed blocks previously zero; "
+              << EdgeRecords << " CFG edge counts imported\n";
+    return Error::success();
+  }
+};
+}}
+#endif
