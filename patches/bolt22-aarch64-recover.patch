+// Experimental recovery of linked AArch64 code-address materialization.
+#ifndef BOLT_REWRITE_RECOVER_CODE_RELOCS_H
+#define BOLT_REWRITE_RECOVER_CODE_RELOCS_H
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinaryFunction.h"
+#include "bolt/Core/MCPlusBuilder.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/MC/MCDisassembler/MCDisassembler.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/CommandLine.h"
+#include <algorithm>
+#include <set>
+#include <vector>
+namespace llvm { namespace bolt {
+static cl::opt<bool> PGO128AssumeCodePagesSafe(
+    "pgo128-assume-code-pages-safe",
+    cl::desc("do not retain code pages with unresolved ADRP arithmetic"),
+    cl::init(false), cl::Hidden);
+
+inline void recoverTraceCodeRelocations(BinaryContext &BC) {
+  uint64_t Pairs=0, RelaxedADRs=0, DataEntries=0, AmbiguousPages=0;
+  std::set<uint64_t> KeepPages, KeepFunctions;
+  DenseSet<uint64_t> InstructionEntries;
+  auto codeSymbol=[&](uint64_t Address)->MCSymbol* {
+    BinaryFunction *Target=BC.getBinaryFunctionContainingAddress(Address);
+    if (!Target || (Address & 3) || Target->isInConstantIsland(Address)) return nullptr;
+    const uint64_t Offset=Address-Target->getAddress();
+    return Offset ? Target->addEntryPointAtOffset(Offset) : Target->getSymbol();
+  };
+  auto isCode=[&](uint64_t Address) {
+    auto S=BC.getSectionForAddress(Address); return S && S->isText();
+  };
+  std::vector<std::pair<uint64_t,uint64_t>> TextRanges;
+  for (BinarySection &S : BC.allocatableSections())
+    if (S.isText() && S.getSize()) TextRanges.emplace_back(S.getAddress(),S.getAddress()+S.getSize());
+  auto isCodePage=[&](uint64_t Page) {
+    return llvm::any_of(TextRanges,[&](auto Range) {
+      return std::max(Page,Range.first)<std::min(Page+4096,Range.second);
+    });
+  };
+  auto immediate21=[](uint32_t Word) {
+    int64_t Imm=((Word>>5)&0x7ffff)*4+((Word>>29)&3);
+    return (Imm & 0x100000) ? Imm-0x200000 : Imm;
+  };
+  auto signedImmediate=[](uint64_t Value,unsigned Bits) {
+    return (Value & (1ULL<<(Bits-1))) ? int64_t(Value)-int64_t(1ULL<<Bits) : int64_t(Value);
+  };
+  // No recovered pair may require an instruction that an incoming branch or
+  // externally stored code address can bypass. This also guards NOP+ADR where
+  // the ADR itself is an old secondary entry.
+  for (auto &Item : BC.getBinaryFunctions()) {
+    BinaryFunction &BF=Item.second;InstructionEntries.insert(BF.getAddress());
+    if (BF.isPseudo() || !BF.getSize()) continue;
+    auto Raw=BF.getData();if (!Raw) continue;
+    const ArrayRef<uint8_t> Bytes=*Raw;
+    const uint64_t Size=std::min<uint64_t>(BF.getSize(),Bytes.size());
+    for (uint64_t Off=0;Off+4<=Size;Off+=4) {
+      const uint64_t Address=BF.getAddress()+Off;
+      if (BF.isInConstantIsland(Address)) continue;
+      const uint32_t Word=support::endian::read32le(Bytes.data()+Off);
+      if ((Word & 0x7c000000)==0x14000000)
+        InstructionEntries.insert(Address+signedImmediate(Word&0x3ffffff,26)*4);
+      else if ((Word & 0xff000010)==0x54000000 || (Word & 0x7e000000)==0x34000000)
+        InstructionEntries.insert(Address+signedImmediate((Word>>5)&0x7ffff,19)*4);
+      else if ((Word & 0x7e000000)==0x36000000)
+        InstructionEntries.insert(Address+signedImmediate((Word>>5)&0x3fff,14)*4);
+    }
+  }
+  // All relative code pointers in dynamic data need their secondary entry
+  // points registered before CFG construction and function reordering.
+  for (BinarySection &Section : BC.allocatableSections())
+    for (const Relocation &R : Section.dynamicRelocations()) {
+      if (R.Symbol || !R.isRelative()) continue;
+      if (isCode(R.Addend) && codeSymbol(R.Addend)) {
+        ++DataEntries;InstructionEntries.insert(R.Addend);
+      }
+    }
+  for (auto &Item : BC.getBinaryFunctions()) {
+    BinaryFunction &BF=Item.second;
+    if (BF.isPseudo() || !BF.getSize()) continue;
+    auto Raw=BF.getData(); if (!Raw) continue;
+    const ArrayRef<uint8_t> Bytes=*Raw;
+    const uint64_t Size=std::min<uint64_t>(BF.getSize(),Bytes.size());
+    for (uint64_t Off=0;Off+4<=Size;Off+=4) {
+      const uint64_t Address=BF.getAddress()+Off;
+      if (BF.isInConstantIsland(Address) || BF.getRelocationAt(Off)) continue;
+      const uint32_t Word=support::endian::read32le(Bytes.data()+Off);
+      if ((Word & 0x9f000000)==0x10000000) {
+        const uint64_t Target=Address+immediate21(Word);
+        if (!isCode(Target)) continue;
+        MCSymbol *Symbol=codeSymbol(Target); if (!Symbol) continue;
+        if (Off>=4 && !InstructionEntries.contains(Address) &&
+            support::endian::read32le(Bytes.data()+Off-4)==0xd503201f) {
+          // Represent the linker's NOP+ADR relaxation using its original low
+          // relocation. Symbolizer and scanExternalRefs already undo this pair.
+          BF.addRelocation(Address,Symbol,ELF::R_AARCH64_ADD_ABS_LO12_NC,0,Target);
+          ++RelaxedADRs;
+        } else if (auto *T=BC.getBinaryFunctionContainingAddress(Target);T && T!=&BF) {
+          // Original code with a bare ADR cannot grow an instruction in place.
+          KeepFunctions.insert(T->getAddress());
+        }
+        continue;
+      }
+      if ((Word & 0x9f000000)!=0x90000000) continue;
+      const uint64_t Page=(Address & ~0xfffULL)+immediate21(Word)*4096;
+      if (!isCodePage(Page)) continue;
+      MCInst PageInst;uint64_t InstSize=0;
+      if (!BC.DisAsm->getInstruction(PageInst,InstSize,Bytes.slice(Off),Address,nulls()) ||
+          !BC.MIB->isADRP(PageInst)) {KeepPages.insert(Page);continue;}
+      const MCPhysReg Base=PageInst.getOperand(0).getReg();
+      const BitVector &Aliases=BC.MIB->getAliases(Base);
+      bool Recovered=false;
+      for (uint64_t Next=Off+4;Next+4<=Size && Next<=Off+64;Next+=4) {
+        if (InstructionEntries.contains(BF.getAddress()+Next)) break;
+        if (BF.isInConstantIsland(BF.getAddress()+Next) || BF.getRelocationAt(Next)) break;
+        const uint32_t LowWord=support::endian::read32le(Bytes.data()+Next);
+        MCInst LowInst;uint64_t LowSize=0;
+        if (!BC.DisAsm->getInstruction(LowInst,LowSize,Bytes.slice(Next),BF.getAddress()+Next,nulls())) break;
+        if (BC.MIB->isBranch(LowInst) || BC.MIB->isCall(LowInst)) break;
+        if ((LowWord & 0xffc00000)==0x91000000 &&
+            (LowWord & 31)==(Word & 31) && ((LowWord>>5)&31)==(Word & 31)) {
+          const uint64_t Target=Page+((LowWord>>10)&4095);
+          if (MCSymbol *Symbol=codeSymbol(Target)) {
+            BF.addRelocation(Address,Symbol,ELF::R_AARCH64_ADR_PREL_PG_HI21,0,Target);
+            BF.addRelocation(BF.getAddress()+Next,Symbol,ELF::R_AARCH64_ADD_ABS_LO12_NC,0,Target);
+            ++Pairs;Recovered=true;
+          }
+          break;
+        }
+        BitVector Used(BC.MRI->getNumRegs()),Written(BC.MRI->getNumRegs());
+        BC.MIB->getUsedRegs(LowInst,Used);BC.MIB->getWrittenRegs(LowInst,Written);
+        Used &= Aliases;Written &= Aliases;
+        if (Used.any() || Written.any()) break;
+      }
+      if (!Recovered) KeepPages.insert(Page);
+    }
+  }
+  // Unresolved code-page references retain all affected input functions. This
+  // preserves address arithmetic rather than guessing a symbol from its page.
+  if (!PGO128AssumeCodePagesSafe) {
+    for (uint64_t Page : KeepPages) {
+      ++AmbiguousPages;
+      auto It=BC.getBinaryFunctions().lower_bound(Page);
+      if (It!=BC.getBinaryFunctions().begin()) --It;
+      for (;It!=BC.getBinaryFunctions().end() && It->first<Page+4096;++It)
+        if (It->second.getAddress()+It->second.getSize()>Page)
+          KeepFunctions.insert(It->first);
+    }
+  }
+  for (uint64_t Address : KeepFunctions)
+    if (auto *BF=BC.getBinaryFunctionAtAddress(Address)) BF->setIgnored();
+  BC.outs()<<"PGO128-RECOVER: "<<Pairs<<" ADRP+ADD pairs; "<<RelaxedADRs
+           <<" NOP+ADR pairs; "<<DataEntries<<" dynamic code pointers; "
+           <<AmbiguousPages<<" ambiguous pages; "<<KeepFunctions.size()
+           <<" functions retained at original addresses\n";
+}
+}}
+#endif
